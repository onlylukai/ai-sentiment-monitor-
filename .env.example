# ===========================================
# AI 舆情监控系统 - 配置
# ===========================================

# LLM API 配置（支持 OpenAI 兼容接口）
LLM_API_KEY=your_a…here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# 微信通知配置
WECHAT_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here

# 监控配置
DEFAULT_INTERVAL=30          # 监控间隔（分钟）
ALERT_THRESHOLD=0.7          # 情感预警阈值
TOP_KEYWORDS_COUNT=20        # 热词数量
MAX_ARTICLES=100             # 最大采集文章数

# 数据库配置
DATABASE_PATH=data/sentiment.db

# 爬虫配置
CRAWLER_TIMEOUT=15
CRAWLER_RETRY=3
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# 报告配置
REPORT_TEMPLATE=templates/report.html
OUTPUT_DIR=output/reports
# GitHub API Token（强烈推荐）
# 未登录仅 60 次/小时且与本机共享，日常监控很快会用尽
# 申请: https://github.com/settings/tokens/new  无需勾选任何权限
GITHUB_TOKEN=
